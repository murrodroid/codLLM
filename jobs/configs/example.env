# example training config for jobs/train.sh
CODLLM_HF_MODEL=google/flan-t5-small
CODLLM_MAX_SOURCE_LENGTH=256
CODLLM_MAX_TARGET_LENGTH=32
CODLLM_LR=1e-6
CODLLM_WEIGHT_DECAY=0.0
CODLLM_NUM_TRAIN_EPOCHS=8
CODLLM_PER_DEVICE_TRAIN_BATCH_SIZE=8
CODLLM_PER_DEVICE_EVAL_BATCH_SIZE=8
CODLLM_GRADIENT_ACCUMULATION_STEPS=2
CODLLM_WARMUP_STEPS=1000
CODLLM_LOGGING_STEPS=25
CODLLM_EVAL_STRATEGY=epoch
CODLLM_SAVE_STRATEGY=epoch
CODLLM_SAVE_STRATEGY_BEST_METRIC=accuracy
CODLLM_TRAINING_INPUT=cod
CODLLM_PRETRAIN_ENABLED=0
CODLLM_PRETRAIN_MASTERLIST_PATH=data/raw/ICD10h_Masterlist_2024.xlsx
CODLLM_PRETRAIN_MASTERLIST_SHEET_NAME=Masterlist
CODLLM_PRETRAIN_NUM_TRAIN_EPOCHS=1
# optional; when unset, pretraining uses CODLLM_LR
# CODLLM_PRETRAIN_LEARNING_RATE=1e-5
# evaluate pretraining validation every N epochs
CODLLM_PRETRAIN_EVAL_EVERY_N_EPOCHS=1
CODLLM_VERBOSE=1
FORCE_REPROCESS=0
