# LSF submission overrides
RUNTIME=03:00

# base training config for flan-t5-large on h100
CODLLM_HF_MODEL=google/flan-t5-large
CODLLM_LR=2.5e-5
CODLLM_DATASET_SIZE=0.5
CODLLM_NUM_TRAIN_EPOCHS=8
CODLLM_SAVE_STRATEGY=no
CODLLM_SAVE_STRATEGY_BEST_METRIC=macro_f1

CODLLM_BALANCE_STRATEGY=none
CODLLM_BALANCE_TARGET_QUANTILE=0.5
CODLLM_BALANCE_UPSAMPLE_INVERSE_POWER=0.5
CODLLM_BALANCE_UPSAMPLE_BUDGET_RATIO=0.5

CODLLM_MAX_SOURCE_LENGTH=256
CODLLM_MAX_TARGET_LENGTH=32
CODLLM_WEIGHT_DECAY=0.0
CODLLM_DATALOADER_NUM_WORKERS=16
CODLLM_PER_DEVICE_TRAIN_BATCH_SIZE=256
CODLLM_PER_DEVICE_EVAL_BATCH_SIZE=256
CODLLM_GRADIENT_ACCUMULATION_STEPS=1
CODLLM_WARMUP_STEPS=500
CODLLM_LOGGING_STEPS=25
CODLLM_EVAL_STRATEGY=epoch
CODLLM_TRAINING_INPUT=cod
CODLLM_VERBOSE=1
FORCE_REPROCESS=0

# pre training
CODLLM_PRETRAIN_ENABLED=1
CODLLM_PRETRAIN_NUM_TRAIN_EPOCHS=100
CODLLM_PRETRAIN_LR_SCHEDULER_TYPE=linear
CODLLM_PRETRAIN_EVAL_EVERY_N_EPOCHS=10


# less determinism, more throughput for model
CODLLM_DETERMINISTIC_ALGORITHMS=0
CODLLM_CUDNN_DETERMINISTIC=0
CODLLM_CUDNN_BENCHMARK=1
